{
    "poll_interval_seconds": 300,
    "notifications": {
        "feishu": {
            "enabled": true,
            "webhook_url": "YOUR_FEISHU_WEBHOOK_URL",
            "app_id": "YOUR_FEISHU_APP_ID",
            "app_secret": "YOUR_FEISHU_APP_SECRET",
            "image_preview": true
        }
    },
    "deepseek": {
        "enabled": true,
        "api_key": "YOUR_DEEPSEEK_API_KEY",
        "model": "deepseek-chat",
        "summary_enabled": true,
        "summary_min_changes": 3,
        "max_tokens": 500,
        "temperature": 0.7
    },
    "monitor_options": {
        "detect_new_products": true,
        "detect_restocks": true,
        "detect_sold_out": true,
        "detect_price_changes": true,
        "notify_on_first_run": false,
        "lightning_sellout_threshold_seconds": 300,
        "bot_alert_min_count": 3,
        "bot_alert_enabled": true
    },
    "database_path": "data/ufotable.db",
    "log_file": "data/ufotable_monitor.log"
}
